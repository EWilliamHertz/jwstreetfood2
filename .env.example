# Admin Dashboard Authentication
ADMIN_PASSWORD=your_admin_password_here
ADMIN_CODE=your_admin_code_here

# Optional: PostgreSQL Database (defaults to local src/data/db.json if omitted)
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Optional: Vercel Blob Storage for uploaded images (defaults to /public/uploads if omitted)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional: Google Places API for fetching live Google Reviews
# GOOGLE_PLACES_API_KEY=AIzaSy...
# GOOGLE_PLACE_ID=ChIJ...
